# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
#
# Public (client-exposed) vars: prefix with VITE_ to expose via import.meta.env.
# Private vars (server-only): used via $env/static/private, e.g. in +server.ts.

VITE_EXCHANGERATE_API_KEY=your_api_key_here

# SMTP settings for the /api/contact Nodemailer endpoint.
# For Gmail SMTP use: host=smtp.gmail.com, port=465 (SSL) or 587 (STARTTLS),
# user=<your gmail address>, pass=<16-char App Password> (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Where contact messages are delivered (defaults to SMTP_USER if empty).
CONTACT_TO_EMAIL=your_email@gmail.com
