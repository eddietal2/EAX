{
  "manifest_version": 3,
  "name": "SimbaFX - Currency Converter",
  "version": "1.0.0",
  "description": "Fast East African currency conversions.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [],
  "host_permissions": [
    "https://api.exchangerate-api.com/*",
    "https://api.exchangerate.host/*",
    "https://simbafx.vercel.app/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
