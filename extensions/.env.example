# Copy this file to `.env` and fill in your real values.
# Only variables prefixed with `VITE_` are exposed to the extension code
# (via import.meta.env) and are baked into the bundle at build time.
# Do NOT commit real secrets in `.env` — it is gitignored.

VITE_EXCHANGERATE_API_KEY=your_api_key_here

# Base URL of the app that hosts the /api/contact Nodemailer endpoint.
# Defaults to https://simbafx.vercel.app if unset. Point this at
# http://localhost:5173 when testing the contact form against a local dev server.
VITE_CONTACT_API_URL=https://simbafx.vercel.app
